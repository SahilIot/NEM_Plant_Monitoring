# Merge these non-secret settings into Nem_Backend/.env.
# Get the endpoint and approved certificate files from your PLC engineer.
# A blank endpoint keeps OPC UA disconnected until explicitly configured.
OPCUA_ENDPOINT=
OPCUA_CLIENT_CERT=certificates/client_cert.der
OPCUA_CLIENT_KEY=certificates/client_key.pem
OPCUA_SERVER_CERT=certificates/server_cert.der
OPCUA_USERNAME=
OPCUA_PASSWORD=
OPCUA_TIMEOUT_SECONDS=10

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before saving an SMTP password in the frontend.
SETTINGS_ENCRYPTION_KEY=

# Backup snapshot files are written here (relative paths are under Nem_Backend/).
BACKUP_DIRECTORY=backups
