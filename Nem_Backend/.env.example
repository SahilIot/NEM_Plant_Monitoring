# SQLite development database. Use a PostgreSQL SQLAlchemy URL when deploying.
DATABASE_URL=sqlite:///./machine_monitor.db

# Comma-separated frontend origins. Leave empty to disable cross-origin access.
CORS_ORIGINS=

# Optional name used by the idempotent demo seed.
DEMO_ROOT_NAME=Demo Root Asset

# Periodic rule evaluation. Disable when an external scheduler is used.
MONITORING_SCHEDULER_ENABLED=true
MONITORING_EVALUATION_INTERVAL_SECONDS=15
MONITORING_DEFAULT_STALE_AFTER_SECONDS=300

# Example PostgreSQL URL (store credentials in your local .env; never commit them):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/machine_monitor
