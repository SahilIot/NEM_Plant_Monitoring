# Copy this setting into Nem_Backend/.env and replace the placeholder values.
# URL-encode special characters in the username or password.
DATABASE_URL=postgresql+psycopg://nem_user:replace_with_password@127.0.0.1:5432/nem_plant_monitoring

# Required before saving an SMTP password in the frontend.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=
BACKUP_DIRECTORY=backups
